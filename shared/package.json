{
  "name": "@contentforge/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, constants, validators, utils, API helpers, hooks, and i18n messages for ContentForge",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./types": "./types/index.ts",
    "./constants": "./constants/index.ts",
    "./validators": "./validators/index.ts",
    "./utils": "./utils/index.ts",
    "./api": "./api/index.ts",
    "./hooks": "./hooks/index.ts",
    "./messages": "./messages/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "zod": "^3.24.0"
  }
}
